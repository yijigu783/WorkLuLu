# Rust 构建产物（约 5 GB，绝对不能进仓库）
/app/src-tauri/target/
# 建了 workspace 之后 target 会落在仓库根，一并排掉
/target/

# Tauri 构建时生成的 schema
/app/src-tauri/gen/schemas/

# 安卓：Gradle 产物与本地配置
/android/**/build/
/android/**/.gradle/
/android/local.properties
/android/**/keystore.properties
*.jks
*.keystore
# gen/android 是**要提交**的 —— 里面是 AndroidManifest、图标、gradle 配置这些
# 需要手工定制的东西（Tauri 官方约定）。只有构建时生成的 schema 排除掉。
/android/src-tauri/gen/schemas/

# 源码备份 zip —— 含 .git 全history 与商业策略，绝不可外发
/backup/

# 交付用的单文件 exe —— 二进制走 GitHub Releases，不进仓库
/工作记录本.exe
*.exe

# 安卓交付包 —— 同上，二进制不进仓库
*.apk
*.aab
# apksigner 生成的 v4 增量签名附属文件
*.idsig

# 视觉校对留下的临时截图（正式素材在 docs/screenshots/）
/app/tools/_shot_*.png
/app/tools/_preview/
/app/tools/_p*/
/app/tools/_m_*/
# make_preview / smoke 生成的一次性静态副本，跑一次就重新生成，没有留存价值
/app/out/

# 本地工作笔记，不适合公开
/.workbuddy/
# 助手的工作记忆（项目日志与长期笔记）—— 是本机工作数据，不是项目源码
/.workbuddy-ai/

# 视频成片与配音 —— 百兆级二进制，和 exe 一样走 Releases / 网盘，不进仓库。
# 脚本和文案（lines.py / make_film.py / 分镜脚本.txt / 投稿文案.txt）要提交。
/docs/bilibili-video/*.mp4
/docs/bilibili-video/voices/
/docs/bilibili-video/试听-全片配音.mp3
/docs/bilibili-video/_check/
/docs/bilibili-video/_probe.json

# 根目录的调试残留（探针脚本、临时输出、便携模式试跑目录）
/_edge_drag*.py
/_edge_drag*.txt
/_evt.txt
/_wv2.txt
/_t/
# 外部下载的参考资料，不属于本项目
/bugbounty/

# 编辑器与系统
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
